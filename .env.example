# Copy this file to .env for local use only. In Netlify create separate Key / Value entries.
# In the Value field paste ONLY the URL or key, never VITE_...=.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy alias supported: VITE_SUPABASE_ANON_KEY (use one key variable, preferably the publishable one).
# Required for the contact form, after the initial website + admin login work:
VITE_TURNSTILE_SITE_KEY=
# Optional canonical deployed origin for server adapters, e.g. your own Netlify domain:
SITE_URL=
